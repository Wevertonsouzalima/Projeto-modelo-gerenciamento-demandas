@page "/admin/usuarios"
@rendermode InteractiveServer
@inject KanbanDbContext Db
@inject ISnackbar Snackbar
@inject IUsuarioAtualProvider UsuarioProvider
@inject IConfiguration Configuracao

<PageTitle>Usuários</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Usuários</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.PersonAdd"
           OnClick="AbrirFormNovo" Class="mb-3">
    Novo Usuário
</MudButton>

<MudTable Items="_usuarios" RowsPerPage="@ItensPorPagina" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh>Ativo</MudTh>
        <MudTh>Notif. E-mail</MudTh>
        <MudTh>E-mails de automação</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">@context.Nome</MudTd>
        <MudTd DataLabel="E-mail">@context.Email</MudTd>
        <MudTd DataLabel="Ativo">
            <MudChip T="string" Color="@(context.Ativo ? Color.Success : Color.Default)" Size="Size.Small">
                @(context.Ativo ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Notif. E-mail">
            <MudIcon Icon="@(context.NotificarPorEmail ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                     Color="@(context.NotificarPorEmail ? Color.Success : Color.Default)" Size="Size.Small" />
        </MudTd>
        <MudTd DataLabel="E-mails de automação">
            <MudIcon Icon="@(context.ReceberEmailsAutomacao ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                     Color="@(context.ReceberEmailsAutomacao ? Color.Success : Color.Default)" Size="Size.Small" />
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="@(() => AbrirFormEdicao(context))" />
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager RowsPerPageString="Por página:" /></PagerContent>
</MudTable>

@if (_formAberto)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6">@(_editando?.Id > 0 ? "Editar" : "Novo") Usuário</MudText>
        <MudTextField @bind-Value="_editando!.Nome" Label="Nome" Required="true" Class="mt-2" />
        <MudTextField @bind-Value="_editando.Email" Label="E-mail" InputType="InputType.Email" Required="true" Class="mt-2" />
        <MudSwitch @bind-Value="_editando.Ativo" Label="Ativo" Color="Color.Primary" Class="mt-2" />
        <MudSwitch @bind-Value="_editando.NotificarPorEmail" Label="Receber notificações por e-mail" Color="Color.Primary" Class="mt-2" />
        <MudSwitch @bind-Value="_editando.ReceberEmailsAutomacao" Label="Receber e-mails de automações (lembretes, cobranças, resumos)" Color="Color.Primary" Class="mt-2" />
        <div class="d-flex gap-2 mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar">Salvar</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="Cancelar">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    private int ItensPorPagina => Math.Max(5, Configuracao.GetValue("Paginacao:ItensPorPagina", 25));

    List<Usuario> _usuarios = [];
    Usuario? _editando;
    bool _formAberto = false;

    protected override async Task OnInitializedAsync()
        => _usuarios = await Db.Usuarios.OrderBy(u => u.Nome).ToListAsync();

    void AbrirFormNovo()
    {
        _editando = new Usuario { Ativo = true };
        _formAberto = true;
    }

    void AbrirFormEdicao(Usuario u)
    {
        _editando = new Usuario
        {
            Id = u.Id, Nome = u.Nome, Email = u.Email,
            Ativo = u.Ativo, NotificarPorEmail = u.NotificarPorEmail, ReceberEmailsAutomacao = u.ReceberEmailsAutomacao
        };
        _formAberto = true;
    }

    async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(_editando?.Nome) ||
            string.IsNullOrWhiteSpace(_editando.Email)) return;

        var uid = UsuarioProvider.ObterIdUsuarioAtual();

        if (_editando.Id == 0)
        {
            _editando.CriadoPorId = uid;
            _editando.CriadoEm = DateTime.UtcNow;
            Db.Usuarios.Add(_editando);
        }
        else
        {
            var existente = await Db.Usuarios.FindAsync(_editando.Id);
            if (existente is null) return;
            existente.Nome = _editando.Nome;
            existente.Email = _editando.Email;
            existente.Ativo = _editando.Ativo;
            existente.NotificarPorEmail = _editando.NotificarPorEmail;
            existente.ReceberEmailsAutomacao = _editando.ReceberEmailsAutomacao;
        }

        await Db.SaveChangesAsync();
        _usuarios = await Db.Usuarios.OrderBy(u => u.Nome).ToListAsync();
        _formAberto = false;
        Snackbar.Add("Usuário salvo com sucesso.", Severity.Success);
    }

    void Cancelar() => _formAberto = false;
}
