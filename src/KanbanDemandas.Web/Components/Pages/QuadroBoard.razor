    private bool FiltrarCartao(Cartao cartao)
    {
        if (_listaFiltro.HasValue && cartao.ListaId != _listaFiltro) return false;
        if (_sistemaFiltro.HasValue && cartao.SistemaId != _sistemaFiltro) return false;
        if (_prioridadeFiltro.HasValue && cartao.Prioridade != _prioridadeFiltro) return false;
        if (_desenvolvedorFiltro.HasValue && !cartao.Desenvolvedores.Any(d => d.UsuarioId == _desenvolvedorFiltro)) return false;
        if (_solicitanteFiltro.HasValue && cartao.SolicitanteId != _solicitanteFiltro) return false;
        if (_etiquetaFiltro.HasValue && !cartao.Etiquetas.Any(e => e.EtiquetaId == _etiquetaFiltro)) return false;
        if (_somenteMeus)
        {
            var usuarioAtualId = UsuarioProvider.ObterIdUsuarioAtual();
            if (!cartao.Desenvolvedores.Any(d => d.UsuarioId == usuarioAtualId)) return false;
        }
        if (_dataDe.HasValue || _dataAte.HasValue)
        {
            var data = ObterCampoData(cartao);
            if (!data.HasValue) return false;
            if (_dataDe.HasValue && data.Value.Date < _dataDe.Value.Date) return false;
            if (_dataAte.HasValue && data.Value.Date > _dataAte.Value.Date) return false;
        }
        if (!string.IsNullOrWhiteSpace(_busca)
            && !cartao.Titulo.Contains(_busca, StringComparison.OrdinalIgnoreCase)
            && !(cartao.Descricao?.Contains(_busca, StringComparison.OrdinalIgnoreCase) ?? false)) return false;
        return true;
    }

