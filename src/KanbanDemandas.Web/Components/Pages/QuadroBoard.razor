    protected override async Task OnParametersSetAsync()
    {
        _carregando = true;
        await CarregarQuadro();
        _carregando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("kanbanDnd.registrarQuadro", _dotNetRef);
        _hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/quadro"))
            .WithAutomaticReconnect()
            .Build();
        _hub.On("QuadroAtualizado", () => InvokeAsync(RecarregarPorAvisoAsync));
        await _hub.StartAsync();
        await _hub.SendAsync("EntrarNoQuadro", QuadroId);

        var cartaoLink = _listas.SelectMany(l => l.Cartoes).FirstOrDefault(c => c.Id == CartaoAbrirId);
        if (cartaoLink is not null) await AbrirDetalhes(cartaoLink);
    }

    // Um único SaveChanges pode gerar vários avisos seguidos; enquanto um recarregamento roda,
    // os avisos seguintes são agrupados em uma única nova carga ao final.
    private async Task RecarregarPorAvisoAsync()
    {
        if (_recarregando)
        {
            _recarregarNovamente = true;
            return;
        }
        _recarregando = true;
        try
        {
            do
            {
                _recarregarNovamente = false;
                await CarregarQuadro();
                StateHasChanged();
            } while (_recarregarNovamente);
        }
        finally
        {
            _recarregando = false;
        }
    }

    // Usa um DbContext próprio: o recarregamento pode ser disparado pelo SignalR enquanto um diálogo
    // ou outra ação ainda usa o DbContext do circuito, e DbContext não aceita operações concorrentes.
    private async Task CarregarQuadro()
    {
        using var escopo = ScopeFactory.CreateScope();
        var db = escopo.ServiceProvider.GetRequiredService<KanbanDbContext>();
        _quadro = await db.Quadros.AsNoTracking().FirstOrDefaultAsync(q => q.Id == QuadroId && !q.Excluido);
        if (_quadro is null) return;
        _sistemas = await db.Sistemas.AsNoTracking().Where(s => s.Ativo).OrderBy(s => s.Nome).ToListAsync();
        _usuarios = await db.Usuarios.AsNoTracking().Where(u => u.Ativo).OrderBy(u => u.Nome).ToListAsync();
        _etiquetas = await db.Etiquetas.AsNoTracking().Where(e => e.QuadroId == QuadroId && !e.Excluido).OrderBy(e => e.Nome).ToListAsync();
        _listas = await db.Listas.AsNoTracking().AsSplitQuery()
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Sistema)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.ItensTarefa)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Comentarios)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Anexos)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Reunioes)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.CartosFilhos.Where(f => !f.Excluido))
            .ThenInclude(f => f.Lista)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.ValoresCampo)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Desenvolvedores)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Etiquetas)
            .ThenInclude(ce => ce.Etiqueta)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.RelacoesDestino)
            .ThenInclude(r => r.CartaoOrigem)
            .ThenInclude(o => o.Lista)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.RelacoesOrigem)
            .ThenInclude(r => r.CartaoDestino)
            .ThenInclude(d => d.Lista)
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.Alertas.Where(a => !a.Resolvido))
            .Include(l => l.Cartoes.Where(c => !c.Excluido))
            .ThenInclude(c => c.VinculosGit.Where(v => v.Tipo == TipoVinculoGit.PullRequest))
            .Include(l => l.DefinicoesCampo)
            .Where(l => l.QuadroId == QuadroId && !l.Excluido)
            .OrderBy(l => l.ListaPaiId).ThenBy(l => l.Ordem).ToListAsync();
        _nomesListas = _listas.ToDictionary(l => l.Id, l => l.Nome);
        _sugestoesPorCartao = (await db.SugestoesAutomacao.AsNoTracking()
                .Where(s => s.QuadroId == QuadroId && s.Status == StatusSugestao.Pendente)
                .GroupBy(s => s.CartaoId).Select(g => new { g.Key, Total = g.Count() }).ToListAsync())
            .ToDictionary(x => x.Key, x => x.Total);
    }

