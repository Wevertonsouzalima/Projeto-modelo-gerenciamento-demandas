@page "/quadros/{QuadroId:int}"
@rendermode InteractiveServer
@inject KanbanDbContext Db
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IUsuarioAtualProvider UsuarioProvider
@inject MovimentacaoCartaoService Movimentacao
@inject AssistenteMovimentacao Assistente
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory
@inject IConfiguration Configuracao
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Rendering

<PageTitle>@(_quadro?.Nome ?? "Quadro")</PageTitle>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_quadro is null)
{
    <MudAlert Severity="Severity.Error">Quadro não encontrado.</MudAlert>
}
else
{
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
        <div>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Voltar">Quadros</MudButton>
            <MudText Typo="Typo.h5" Class="mt-2">@_quadro.Nome</MudText>
            @if (!string.IsNullOrWhiteSpace(_quadro.Descricao))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_quadro.Descricao</MudText>
            }
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Route" OnClick="ConfigurarCaminho">Caminho</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Label" OnClick="GerenciarEtiquetas">Etiquetas</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@(_visaoTabela ? Icons.Material.Filled.ViewKanban : Icons.Material.Filled.TableView)" OnClick="AlternarVisao">
                @(_visaoTabela ? "Board" : "Tabela")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AdicionarLista">Nova lista</MudButton>
        </div>
    </div>
    <MudTextField @bind-Value="_busca" Placeholder="Buscar cartões..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
    <div class="d-flex flex-wrap align-center gap-3 mb-2">
        <MudSelect T="int?" @bind-Value="_listaFiltro" ToStringFunc="@(id => NomeLista(id))" Label="Lista" Clearable="true" Dense="true" Style="min-width: 180px">
            @foreach (var lista in _listas)
            {
                <MudSelectItem Value="@((int?)lista.Id)">@lista.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_sistemaFiltro" ToStringFunc="@(id => _sistemas.FirstOrDefault(x => x.Id == id)?.Nome)" Label="Sistema" Clearable="true" Dense="true" Style="min-width: 180px">
            @foreach (var sistema in _sistemas)
            {
                <MudSelectItem Value="@((int?)sistema.Id)">@sistema.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Prioridade?" @bind-Value="_prioridadeFiltro" Label="Prioridade" Clearable="true" Dense="true" Style="min-width: 160px">
            @foreach (var prioridade in Enum.GetValues<Prioridade>())
            {
                <MudSelectItem Value="@((Prioridade?)prioridade)">@prioridade</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_desenvolvedorFiltro" ToStringFunc="@(id => _usuarios.FirstOrDefault(x => x.Id == id)?.Nome)" Label="Desenvolvedor" Clearable="true" Dense="true" Style="min-width: 180px">
            @foreach (var usuario in _usuarios)
            {
                <MudSelectItem Value="@((int?)usuario.Id)">@usuario.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_solicitanteFiltro" ToStringFunc="@(id => _usuarios.FirstOrDefault(x => x.Id == id)?.Nome)" Label="Solicitante" Clearable="true" Dense="true" Style="min-width: 180px">
            @foreach (var usuario in _usuarios)
            {
                <MudSelectItem Value="@((int?)usuario.Id)">@usuario.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_etiquetaFiltro" ToStringFunc="@(id => _etiquetas.FirstOrDefault(x => x.Id == id)?.Nome)" Label="Etiqueta" Clearable="true" Dense="true" Style="min-width: 160px">
            @foreach (var etiqueta in _etiquetas)
            {
                <MudSelectItem Value="@((int?)etiqueta.Id)">@etiqueta.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="@(_somenteMeus ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Person" OnClick="AlternarSomenteMeus">
            Somente meus cartões
        </MudButton>
    </div>
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <MudSelect T="CampoDataFiltro" @bind-Value="_campoDataFiltro" Label="Filtrar data por" Dense="true" Style="min-width: 160px">
            <MudSelectItem Value="CampoDataFiltro.Prazo">Prazo</MudSelectItem>
            <MudSelectItem Value="CampoDataFiltro.Inicio">Início</MudSelectItem>
            <MudSelectItem Value="CampoDataFiltro.Criacao">Criação</MudSelectItem>
        </MudSelect>
        <MudDatePicker @bind-Date="_dataDe" Label="De" Clearable="true" Style="min-width: 160px" />
        <MudDatePicker @bind-Date="_dataAte" Label="Até" Clearable="true" Style="min-width: 160px" />
        @if (_listaFiltro.HasValue || _sistemaFiltro.HasValue || _prioridadeFiltro.HasValue || _desenvolvedorFiltro.HasValue || _solicitanteFiltro.HasValue || _etiquetaFiltro.HasValue || _somenteMeus || _dataDe.HasValue || _dataAte.HasValue || !string.IsNullOrWhiteSpace(_busca))
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="LimparFiltros">Limpar filtros</MudButton>
        }
    </div>

    @if (_listas.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Este quadro ainda não possui listas.</MudAlert>
    }
    else
    {
        @if (_visaoTabela)
        {
            <div class="d-flex justify-end gap-2 mb-2">
                <MudButton Href='@UrlExportacao("xlsx")' Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload">Excel</MudButton>
                <MudButton Href='@UrlExportacao("pdf")' Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf">PDF</MudButton>
            </div>
            <MudTable Items="CartoesFiltrados" Hover="true" Striped="true" Dense="true" HorizontalScrollbar="true" AllowUnsorted="true" RowsPerPage="@ItensPorPagina">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.Titulo)">Título</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => NomeListaCompleto(c.ListaId))">Lista</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.Sistema != null ? c.Sistema.Nome : null)">Sistema</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => NomeUsuario(c.SolicitanteId))">Solicitante</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => NomesDesenvolvedores(c))">Desenvolvedores</MudTableSortLabel></MudTh>
                    <MudTh>Etiquetas</MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.Prioridade)">Prioridade</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.DataInicio)">Início</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.Prazo)">Prazo</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.Estimativa)">Estimativa</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => c.CriadoEm)">Criado em</MudTableSortLabel></MudTh>
                    @foreach (var nomeCampo in NomesCamposPersonalizados)
                    {
                        <MudTh><MudTableSortLabel T="Cartao" SortBy="@(c => ChaveOrdenacaoCampo(c, nomeCampo))">@nomeCampo</MudTableSortLabel></MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudButton Variant="Variant.Text" OnClick="@(() => AbrirDetalhes(context))">@context.Titulo</MudButton></MudTd>
                    <MudTd>@NomeListaCompleto(context.ListaId)</MudTd>
                    <MudTd>@context.Sistema?.Nome</MudTd>
                    <MudTd>@NomeUsuario(context.SolicitanteId)</MudTd>
                    <MudTd>@NomesDesenvolvedores(context)</MudTd>
                    <MudTd>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var etiqueta in context.Etiquetas.Select(e => e.Etiqueta))
                            {
                                <span class="kanban-etiqueta" style="@($"background:{etiqueta.Cor}")">@etiqueta.Nome</span>
                            }
                        </div>
                    </MudTd>
                    <MudTd>@context.Prioridade</MudTd>
                    <MudTd>@(context.DataInicio?.ToLocalTime().ToString("dd/MM/yyyy"))</MudTd>
                    <MudTd>@(context.Prazo?.ToLocalTime().ToString("dd/MM/yyyy"))</MudTd>
                    <MudTd>@(context.Estimativa?.ToString("0.##"))</MudTd>
                    <MudTd>@context.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                    @foreach (var nomeCampo in NomesCamposPersonalizados)
                    {
                        <MudTd>@ValorCampoFormatado(context, nomeCampo)</MudTd>
                    }
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="mud-text-secondary">Nenhum cartão encontrado com os filtros atuais.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Por página:" PageSizeOptions="@(new[] { ItensPorPagina, ItensPorPagina * 2, ItensPorPagina * 4 })" />
                </PagerContent>
            </MudTable>
        }
        else
        {
        <div class="kanban-board">
            @foreach (var lista in ListasRaiz)
            {
                RenderizarColuna(__builder, lista, false);
            }
        </div>
        }
    }
}

@code {
    [Parameter] public int QuadroId { get; set; }
    [SupplyParameterFromQuery(Name = "cartao")] public int? CartaoAbrirId { get; set; }
    private Quadro? _quadro;
    private List<Lista> _listas = [];
    private Dictionary<int, string> _nomesListas = [];
    private DotNetObjectReference<QuadroBoard>? _dotNetRef;
    private Dictionary<int, int> _sugestoesPorCartao = [];
    private readonly Dictionary<int, int> _limitePorLista = [];

    private bool MostrarDescricao => Configuracao.GetValue("Cartao:MostrarDescricao", true);
    private int LinhasDescricao => Math.Clamp(Configuracao.GetValue("Cartao:LinhasDescricao", 2), 1, 10);
    private int CartoesPorColuna => Math.Max(5, Configuracao.GetValue("Quadro:CartoesPorColuna", 30));
    private int ItensPorPagina => Math.Max(5, Configuracao.GetValue("Paginacao:ItensPorPagina", 25));
    private bool _recarregando;
    private bool _recarregarNovamente;
    private bool _carregando = true;
    private string? _busca;
    private bool _visaoTabela;
    private int? _listaFiltro;
    private int? _sistemaFiltro;
    private Prioridade? _prioridadeFiltro;
    private int? _desenvolvedorFiltro;
    private int? _solicitanteFiltro;
    private int? _etiquetaFiltro;
    private bool _somenteMeus;
    private CampoDataFiltro _campoDataFiltro = CampoDataFiltro.Prazo;
    private DateTime? _dataDe;
    private DateTime? _dataAte;
    private List<Sistema> _sistemas = [];
    private List<Usuario> _usuarios = [];
    private List<Etiqueta> _etiquetas = [];
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hub;

    private enum CampoDataFiltro { Prazo, Inicio, Criacao }

    private IEnumerable<Lista> ListasRaiz
        => _listas.Where(l => !l.ListaPaiId.HasValue || !_nomesListas.ContainsKey(l.ListaPaiId.Value)).OrderBy(l => l.Ordem);

    private string? NomeLista(int? id) => id.HasValue ? _nomesListas.GetValueOrDefault(id.Value) : null;

    private void RenderizarColuna(RenderTreeBuilder __builder, Lista lista, bool ehSublista)
    {
        var sublistas = _listas.Where(l => l.ListaPaiId == lista.Id).OrderBy(l => l.Ordem).ToList();
        var wipExcedido = lista.LimiteWip.HasValue && lista.Cartoes.Count > lista.LimiteWip.Value;
        var classe = ehSublista ? "kanban-subcolumn" : "kanban-column";
        if (sublistas.Count > 0) classe += " kanban-column-grupo";

        <div class="@classe" data-lista-id="@lista.Id">
            <div class="kanban-column-header">
                <div class="kanban-column-handle" draggable="true" data-lista-arrastavel-id="@lista.Id" title="Arraste para reordenar">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@lista.Nome</MudText>
                        @if (lista.EhBacklog)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Backlog</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="@(wipExcedido ? Color.Error : Color.Default)">
                        @lista.Cartoes.Count cartões@(lista.LimiteWip.HasValue ? $" / WIP {lista.LimiteWip}" : "")
                    </MudText>
                </div>
                <div class="d-flex">
                    <MudTooltip Text="Configurar etapa: campos e exigências">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" OnClick="@(() => ConfigurarCampos(lista))" />
                    </MudTooltip>
                    <MudTooltip Text="Adicionar sublista">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" OnClick="@(() => AdicionarSublista(lista))" />
                    </MudTooltip>
                    <MudTooltip Text="Mover lista para a esquerda">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="@(() => ReordenarLista(lista, -1))" />
                    </MudTooltip>
                    <MudTooltip Text="Mover lista para a direita">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="@(() => ReordenarLista(lista, 1))" />
                    </MudTooltip>
                    @if (sublistas.Count == 0)
                    {
                        <MudTooltip Text="Adicionar cartão">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => AdicionarCartao(lista))" />
                        </MudTooltip>
                    }
                </div>
            </div>

            @if (sublistas.Count > 0 && lista.Cartoes.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Listas com sublistas não guardam cartões. Arraste estes para uma sublista.</MudAlert>
            }
            @if (sublistas.Count == 0 || lista.Cartoes.Count > 0)
            {
                var cartoesDaLista = FiltrarCartoes(lista).OrderBy(c => c.Ordem).ToList();
                var visiveis = _limitePorLista.GetValueOrDefault(lista.Id, CartoesPorColuna);
                <div class="kanban-cards">
                    @foreach (var cartao in cartoesDaLista.Take(visiveis))
                    {
                        RenderizarCartao(__builder, lista, cartao);
                    }
                    @if (cartoesDaLista.Count > visiveis)
                    {
                        <MudButton Variant="Variant.Text" FullWidth="true" StartIcon="@Icons.Material.Filled.ExpandMore"
                                   OnClick="@(() => _limitePorLista[lista.Id] = visiveis + CartoesPorColuna)">
                            Mostrar mais (@(cartoesDaLista.Count - visiveis) restantes)
                        </MudButton>
                    }
                </div>
            }
            @if (sublistas.Count > 0)
            {
                <div class="kanban-sublistas">
                    @foreach (var sublista in sublistas)
                    {
                        RenderizarColuna(__builder, sublista, true);
                    }
                </div>
            }
        </div>
    }

    private void RenderizarCartao(RenderTreeBuilder __builder, Lista lista, Cartao cartao)
    {
        var desenvolvedores = cartao.Desenvolvedores.OrderByDescending(d => d.Principal)
            .Select(d => _usuarios.FirstOrDefault(u => u.Id == d.UsuarioId)?.Nome).OfType<string>().ToList();
        var campos = lista.DefinicoesCampo.Where(c => !c.Excluido).OrderBy(c => c.Ordem)
            .Select(c => (Campo: c, Valor: CamposCartao.ValorMaisRecente(cartao.ValoresCampo, c.Id)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Valor) || x.Campo.Obrigatorio)
            .ToList();
        var fixosPendentes = RegrasEtapa.Separar(RegrasEtapa.FixosFaltando(cartao, lista)).ToList();

        <MudPaper Class="kanban-card mb-3" Elevation="1" draggable="true" data-cartao-id="@cartao.Id">
            <div class="kanban-card-topo">
                <div class="kanban-card-titulo kanban-card-link" @onclick="@(() => AbrirDetalhes(cartao))">
                    <span class="kanban-card-codigo">@CodigoCartao.Formatar(cartao.Id, Configuracao["Cartao:PrefixoCodigo"])</span>
                    @cartao.Titulo
                </div>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="kanban-card-menu"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="Ações do cartão">
                    <MudMenuItem Icon="@Icons.Material.Filled.OpenInFull" OnClick="@(() => AbrirDetalhes(cartao))">Abrir detalhes</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditarCartao(cartao))">Editar</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.KeyboardArrowUp" OnClick="@(() => ReordenarCartao(lista, cartao, -1))">Mover para cima</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.KeyboardArrowDown" OnClick="@(() => ReordenarCartao(lista, cartao, 1))">Mover para baixo</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => ExcluirCartao(cartao))">Excluir</MudMenuItem>
                </MudMenu>
            </div>

            @if (MostrarDescricao && !string.IsNullOrWhiteSpace(cartao.Descricao))
            {
                <div class="kanban-card-descricao" style="@($"-webkit-line-clamp:{LinhasDescricao};line-clamp:{LinhasDescricao}")" title="@cartao.Descricao">@cartao.Descricao</div>
            }

            @if (cartao.Alertas.Count > 0 || _sugestoesPorCartao.ContainsKey(cartao.Id))
            {
                <div class="d-flex flex-wrap gap-1 mt-2">
                    @foreach (var alerta in cartao.Alertas.OrderByDescending(a => a.Severidade))
                    {
                        <MudTooltip Text="@($"{alerta.Mensagem} (automação) — clique para resolver")">
                            <MudChip T="string" Size="Size.Small" Color="@CorAlerta(alerta.Severidade)" Icon="@IconeAlerta(alerta.Severidade)"
                                     OnClick="@(() => ResolverAlerta(alerta))" Class="kanban-alerta">@alerta.Mensagem</MudChip>
                        </MudTooltip>
                    }
                    @if (_sugestoesPorCartao.TryGetValue(cartao.Id, out var sugestoes))
                    {
                        <MudTooltip Text="Há sugestão de automação para este cartão — abra os detalhes para aprovar ou rejeitar">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Lightbulb" OnClick="@(() => AbrirDetalhes(cartao))">
                                @(sugestoes == 1 ? "1 sugestão" : $"{sugestoes} sugestões")
                            </MudChip>
                        </MudTooltip>
                    }
                </div>
            }

            @if (cartao.Etiquetas.Count > 0)
            {
                <div class="kanban-card-secao d-flex flex-wrap gap-1">
                    @foreach (var etiqueta in cartao.Etiquetas.Select(ce => ce.Etiqueta))
                    {
                        <span class="kanban-etiqueta" style="@($"background:{etiqueta.Cor}")">@etiqueta.Nome</span>
                    }
                </div>
            }

            @if (cartao.Sistema is not null || desenvolvedores.Count > 0)
            {
                <div class="kanban-card-secao">
                    @if (cartao.Sistema is not null)
                    {
                        <div class="kanban-card-linha" title="Sistema">
                            <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small" />
                            <span>@cartao.Sistema.Nome</span>
                        </div>
                    }
                    @if (desenvolvedores.Count > 0)
                    {
                        <div class="kanban-card-linha" title="Desenvolvedores">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            <span>@string.Join(", ", desenvolvedores)</span>
                        </div>
                    }
                </div>
            }

            @if (campos.Count > 0 || fixosPendentes.Count > 0)
            {
                <div class="kanban-card-secao">
                    @foreach (var fixo in fixosPendentes)
                    {
                        <div class="kanban-card-linha">
                            <span class="kanban-card-campo-nome">@RegrasEtapa.Nome(fixo):</span>
                            <span class="kanban-card-campo-pendente">pendente</span>
                        </div>
                    }
                    @foreach (var (campo, valor) in campos)
                    {
                        <div class="kanban-card-linha">
                            <span class="kanban-card-campo-nome">@campo.Nome:</span>
                            @if (string.IsNullOrWhiteSpace(valor))
                            {
                                <span class="kanban-card-campo-pendente">pendente</span>
                            }
                            else
                            {
                                <span>@CamposCartao.Formatar(campo.Tipo, valor)</span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="kanban-card-rodape">
                @if (cartao.OrigemPortal)
                {
                    <MudTooltip Text="@($"Aberto pelo portal{(string.IsNullOrWhiteSpace(cartao.TipoSolicitacao) ? "" : $" · {cartao.TipoSolicitacao}")}")">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" Color="Color.Info" />
                    </MudTooltip>
                }
                @if (cartao.VinculosGit.OrderByDescending(v => v.AtualizadoEm).FirstOrDefault() is { } pr)
                {
                    <MudTooltip Text="@($"PR {pr.Titulo}")">
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.MergeType" Variant="Variant.Outlined"
                                 Color="@(pr.Estado switch { EstadoPullRequest.Mergeado => Color.Secondary, EstadoPullRequest.Fechado => Color.Default, _ => Color.Success })">
                            @(pr.Estado switch { EstadoPullRequest.Mergeado => "mergeado", EstadoPullRequest.Fechado => "fechado", _ => "PR aberto" })
                        </MudChip>
                    </MudTooltip>
                }
                @if (cartao.Prioridade.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="CorPrioridade(cartao.Prioridade.Value)">@cartao.Prioridade.Value</MudChip>
                }
                @if (cartao.DataInicio.HasValue)
                {
                    <MudTooltip Text="Início">
                        <MudText Typo="Typo.caption">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> @cartao.DataInicio.Value.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudText>
                    </MudTooltip>
                }
                @if (cartao.Prazo.HasValue)
                {
                    <MudTooltip Text="Prazo">
