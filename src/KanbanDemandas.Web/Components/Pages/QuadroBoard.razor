    // Campos personalizados são definidos por lista; na tabela, campos de mesmo nome em listas diferentes viram uma coluna só.
    private IEnumerable<string> NomesCamposPersonalizados
        => _listas.SelectMany(l => l.DefinicoesCampo).Where(d => !d.Excluido)
            .Select(d => d.Nome.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n);

    private (DefinicaoCampo? Campo, string? Valor) ValorCampo(Cartao cartao, string nomeCampo)
    {
        var campo = _listas.FirstOrDefault(l => l.Id == cartao.ListaId)?.DefinicoesCampo
            .FirstOrDefault(d => !d.Excluido && d.Nome.Trim().Equals(nomeCampo, StringComparison.OrdinalIgnoreCase));
        if (campo is null)
        {
            var idsMesmoNome = _listas.SelectMany(l => l.DefinicoesCampo)
                .Where(d => !d.Excluido && d.Nome.Trim().Equals(nomeCampo, StringComparison.OrdinalIgnoreCase)).ToList();
            var valor = cartao.ValoresCampo.Where(v => idsMesmoNome.Any(d => d.Id == v.DefinicaoCampoId))
                .OrderByDescending(v => v.DataPreenchimento).FirstOrDefault();
            return valor is null ? (null, null) : (idsMesmoNome.First(d => d.Id == valor.DefinicaoCampoId), valor.Valor);
        }
        return (campo, CamposCartao.ValorMaisRecente(cartao.ValoresCampo, campo.Id));
    }

    private string? ValorCampoFormatado(Cartao cartao, string nomeCampo)
    {
        var (campo, valor) = ValorCampo(cartao, nomeCampo);
        return campo is null || string.IsNullOrWhiteSpace(valor) ? null : CamposCartao.Formatar(campo.Tipo, valor);
    }

    private object? ChaveOrdenacaoCampo(Cartao cartao, string nomeCampo)
    {
        var (campo, valor) = ValorCampo(cartao, nomeCampo);
        if (campo is null || string.IsNullOrWhiteSpace(valor)) return null;
        return campo.Tipo switch
        {
            TipoCampo.Numero => decimal.TryParse(valor, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null,
            TipoCampo.Data => DateTime.TryParse(valor, out var d) ? d : null,
            _ => valor
        };
    }

