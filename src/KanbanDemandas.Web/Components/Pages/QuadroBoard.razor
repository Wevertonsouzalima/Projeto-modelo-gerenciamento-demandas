                    </MudTooltip>
                }
                @if (cartao.Reunioes.Count > 0)
                {
                    <MudTooltip Text="Reuniões">
                        <MudText Typo="Typo.caption"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" /> @cartao.Reunioes.Count</MudText>
                    </MudTooltip>
                }
                @if (cartao.Anexos.Count > 0)
