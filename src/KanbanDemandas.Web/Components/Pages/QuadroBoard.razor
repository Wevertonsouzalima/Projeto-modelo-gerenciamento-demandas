    private static Color CorPrioridade(Prioridade prioridade) => prioridade switch
    {
        Prioridade.Critica => Color.Error,
        Prioridade.Alta => Color.Warning,
        Prioridade.Baixa => Color.Info,
        _ => Color.Default
    };

    private static Color CorPrazo(DateTime prazo) => prazo.Date < DateTime.Today ? Color.Error : prazo.Date <= DateTime.Today.AddDays(2) ? Color.Warning : Color.Default;

    private string UrlExportacao(string formato)
    {
        var parametros = new List<string> { $"quadroId={QuadroId}" };
        if (!string.IsNullOrWhiteSpace(_busca)) parametros.Add($"busca={Uri.EscapeDataString(_busca)}");
        if (_sistemaFiltro.HasValue) parametros.Add($"sistemaId={_sistemaFiltro.Value}");
        if (_desenvolvedorFiltro.HasValue) parametros.Add($"desenvolvedorId={_desenvolvedorFiltro.Value}");
        if (_solicitanteFiltro.HasValue) parametros.Add($"solicitanteId={_solicitanteFiltro.Value}");
        if (_listaFiltro.HasValue) parametros.Add($"listaId={_listaFiltro.Value}");
        if (_prioridadeFiltro.HasValue) parametros.Add($"prioridade={_prioridadeFiltro.Value}");
        if (_etiquetaFiltro.HasValue) parametros.Add($"etiquetaId={_etiquetaFiltro.Value}");
        if (_somenteMeus) parametros.Add($"responsavelId={UsuarioProvider.ObterIdUsuarioAtual()}");
        if (_dataDe.HasValue || _dataAte.HasValue)
        {
            parametros.Add($"campoData={_campoDataFiltro.ToString().ToLowerInvariant()}");
            if (_dataDe.HasValue) parametros.Add($"dataDe={_dataDe.Value:yyyy-MM-dd}");
            if (_dataAte.HasValue) parametros.Add($"dataAte={_dataAte.Value:yyyy-MM-dd}");
        }
        return $"/api/export/cartoes.{formato}?{string.Join("&", parametros)}";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_hub is null) return;
        await _hub.SendAsync("SairDoQuadro", QuadroId);
        await _hub.DisposeAsync();
    }
}
