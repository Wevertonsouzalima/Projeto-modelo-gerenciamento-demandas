    /// <summary>
    /// Uma relação é sempre gravada com CartaoOrigemId = cartão que estava aberto no momento da criação
    /// do vínculo. "BloqueadoPor" registrado a partir do cartão A (origem=A) significa "A é bloqueado por
    /// destino", então A está bloqueado se destino não estiver concluído. "Bloqueia" registrado a partir de
    /// A (origem=A) significa "A bloqueia destino", então quem fica bloqueado é o destino, não A.
    /// </summary>
    private static bool EstaBloqueado(Cartao cartao)
        => cartao.RelacoesOrigem.Any(r => r.Tipo == TipoRelacaoCartao.BloqueadoPor
                && !r.CartaoDestino.Lista.Nome.Equals("Concluído", StringComparison.OrdinalIgnoreCase))
        || cartao.RelacoesDestino.Any(r => r.Tipo == TipoRelacaoCartao.Bloqueia
                && !r.CartaoOrigem.Lista.Nome.Equals("Concluído", StringComparison.OrdinalIgnoreCase));

    [JSInvokable]
    public Task ReordenarListaAsync(int origemId, int destinoId) => InvokeAsync(async () =>
    {
        if (origemId == destinoId) return;
        var origem = _listas.FirstOrDefault(l => l.Id == origemId);
        var destino = _listas.FirstOrDefault(l => l.Id == destinoId);
        if (origem is null || destino is null || origem.ListaPaiId != destino.ListaPaiId) return;

        var irmas = _listas.Where(l => l.ListaPaiId == destino.ListaPaiId).OrderBy(l => l.Ordem).Select(l => l.Id).ToList();
        var indiceDestino = irmas.IndexOf(destinoId);
        var paraDireita = irmas.IndexOf(origemId) < indiceDestino;
        irmas.Remove(origemId);
        irmas.Insert(irmas.IndexOf(destinoId) + (paraDireita ? 1 : 0), origemId);
        await SalvarOrdemListasAsync(irmas);
        StateHasChanged();
    });

    private void MoverCartaoNaTela(int cartaoId, int listaDestinoId, int? cartaoAlvoId)
    {
        var folha = ListasQuadro.PrimeiraFolha(listaDestinoId, _listas);
        if (folha != listaDestinoId) (listaDestinoId, cartaoAlvoId) = (folha, null);
        var origem = _listas.FirstOrDefault(l => l.Cartoes.Any(c => c.Id == cartaoId));
        var destino = _listas.FirstOrDefault(l => l.Id == listaDestinoId);
        if (origem is null || destino is null || cartaoAlvoId == cartaoId) return;

        var cartao = origem.Cartoes.First(c => c.Id == cartaoId);
        origem.Cartoes.Remove(cartao);
        var ordenados = destino.Cartoes.OrderBy(c => c.Ordem).ToList();
        var indice = cartaoAlvoId.HasValue ? ordenados.FindIndex(c => c.Id == cartaoAlvoId.Value) : -1;
        ordenados.Insert(indice < 0 ? ordenados.Count : indice, cartao);
        for (var i = 0; i < ordenados.Count; i++) ordenados[i].Ordem = i;
        cartao.ListaId = listaDestinoId;
        destino.Cartoes.Add(cartao);
    }

    [JSInvokable]
    public Task MoverCartaoAsync(int cartaoId, int listaDestinoId, int? cartaoAlvoId) => InvokeAsync(async () =>
    {
        MoverCartaoNaTela(cartaoId, listaDestinoId, cartaoAlvoId);
        StateHasChanged();
        await Assistente.MoverAsync(cartaoId, listaDestinoId, cartaoAlvoId);
        await CarregarQuadro();
        StateHasChanged();
    });

    private async Task ReordenarCartao(Lista lista, Cartao cartao, int deslocamento)
    {
        var ordenados = lista.Cartoes.OrderBy(c => c.Ordem).ToList();
        var indice = ordenados.FindIndex(c => c.Id == cartao.Id);
        var novoIndice = indice + deslocamento;
        if (indice < 0 || novoIndice < 0 || novoIndice >= ordenados.Count) return;
        var vizinho = ordenados[novoIndice];
        (cartao.Ordem, vizinho.Ordem) = (vizinho.Ordem, cartao.Ordem);
        var atual = await Db.Cartoes.Where(c => c.Id == cartao.Id || c.Id == vizinho.Id).ToListAsync();
        var atualCartao = atual.First(c => c.Id == cartao.Id);
        var atualVizinho = atual.First(c => c.Id == vizinho.Id);
        atualCartao.Ordem = cartao.Ordem;
        atualVizinho.Ordem = vizinho.Ordem;
        await Db.SaveChangesAsync();
        await CarregarQuadro();
    }

    private async Task ReordenarLista(Lista lista, int deslocamento)
    {
        var irmas = _listas.Where(l => l.ListaPaiId == lista.ListaPaiId).OrderBy(l => l.Ordem).Select(l => l.Id).ToList();
        var indice = irmas.IndexOf(lista.Id);
        var novoIndice = indice + deslocamento;
        if (indice < 0 || novoIndice < 0 || novoIndice >= irmas.Count) return;
        (irmas[indice], irmas[novoIndice]) = (irmas[novoIndice], irmas[indice]);
        await SalvarOrdemListasAsync(irmas);
    }

    private async Task SalvarOrdemListasAsync(List<int> irmas)
    {
        if (!CaminhoQuadro.RespeitaCaminho(irmas, _listas))
        {
            Snackbar.Add("Essa ordem contraria o caminho configurado do quadro.", Severity.Warning);
            return;
        }
        var entidades = await Db.Listas.Where(l => irmas.Contains(l.Id)).ToListAsync();
        for (var i = 0; i < irmas.Count; i++)
            entidades.First(l => l.Id == irmas[i]).Ordem = i;
        await Db.SaveChangesAsync();
        await CarregarQuadro();
    }

