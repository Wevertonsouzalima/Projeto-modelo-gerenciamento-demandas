    private async Task RegistrarReuniao()
    {
        if (_cartao is null || !_dataReuniao.HasValue || string.IsNullOrWhiteSpace(_ata)) return;
        var reuniao = new Reuniao
        {
            CartaoId = CartaoId, Data = _dataReuniao.Value.ToUniversalTime(), Ata = _ata.Trim(),
            AutorId = UsuarioProvider.ObterIdUsuarioAtual(), CriadoPorId = UsuarioProvider.ObterIdUsuarioAtual(), CriadoEm = DateTime.UtcNow
        };
        Db.Reunioes.Add(reuniao);
        await Db.SaveChangesAsync();
        Db.ReuniaoParticipantes.AddRange(_participantes.Select(id => new ReuniaoParticipante { ReuniaoId = reuniao.Id, UsuarioId = id }));
        await Db.SaveChangesAsync();
        await NotificarMencoesAsync(reuniao.Ata, TipoNotificacao.MencaoReuniao);
        IncluirUmaVez(_cartao.Reunioes, reuniao);
        IncluirUmaVez(_reunioes, reuniao);
        _ata = null;
        _participantes = [];
