    }

    private async Task EnviarEmail()
    {
        if (_cartao is null || string.IsNullOrWhiteSpace(_emailPara)) return;
        var email = new EmailCartao
        {
            CartaoId = CartaoId, Para = _emailPara.Trim(), Assunto = AssuntoEmailFinal,
            CorpoHtml = MontarCorpoEmailHtml(), EnviadoPorId = UsuarioProvider.ObterIdUsuarioAtual(), EnviadoEm = DateTime.UtcNow,
            CriadoPorId = UsuarioProvider.ObterIdUsuarioAtual(), CriadoEm = DateTime.UtcNow
        };
        try
        {
            await EmailSender.EnviarAsync(email.Para, email.Cc, email.Assunto, email.CorpoHtml);
            email.Enviado = true;
            Snackbar.Add("E-mail enviado.", Severity.Success);
        }
        catch (Exception ex)
        {
            email.ErroEnvio = ex.Message;
            Snackbar.Add("Não foi possível enviar o e-mail.", Severity.Error);
        }
        Db.EmailsCartao.Add(email);
        if (email.Enviado)
        {
            Db.HistoricoAtividades.Add(new HistoricoAtividade
            {
                CartaoId = CartaoId, Tipo = TipoHistoricoAtividade.EmailEnviado,
                Descricao = $"E-mail enviado para {email.Para}.", UsuarioId = UsuarioProvider.ObterIdUsuarioAtual(), OcorridoEm = DateTime.UtcNow
            });
        }
        await Db.SaveChangesAsync();
        IncluirUmaVez(_cartao.Emails, email);
        if (email.Enviado)
        {
            _emailPreVisualizando = false;
            PrepararRascunhoEmail();
        }
    }

