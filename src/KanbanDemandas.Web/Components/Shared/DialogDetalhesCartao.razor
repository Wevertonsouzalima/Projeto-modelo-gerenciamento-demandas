    private bool _emailPreVisualizando;

    private List<(string Papel, Usuario Usuario)> SugestoesDestinatario
    {
        get
        {
            if (_cartao is null) return [];
            var sugestoes = new List<(string, Usuario)>();
            if (_cartao.Solicitante is { Email.Length: > 0 } solicitante) sugestoes.Add(("Solicitante", solicitante));
            foreach (var dev in _cartao.Desenvolvedores.OrderByDescending(d => d.Principal).Where(d => !string.IsNullOrWhiteSpace(d.Usuario.Email)))
                sugestoes.Add((dev.Principal ? "Dev. principal" : "Desenvolvedor", dev.Usuario));
            return sugestoes;
        }
    }

    private string AssuntoEmailFinal => string.IsNullOrWhiteSpace(_emailAssunto) ? _cartao?.Titulo ?? "" : SubstituirMarcadores(_emailAssunto.Trim(), html: false);

    private string LinkCartao => _cartao is null ? "" : Nav.ToAbsoluteUri($"/quadros/{_cartao.Lista.QuadroId}?cartao={_cartao.Id}").ToString();

    /// <summary>Destinatário padrão: solicitante; sem solicitante com e-mail, o desenvolvedor principal.</summary>
    private void PrepararRascunhoEmail()
    {
        _emailPara = SugestoesDestinatario.FirstOrDefault().Usuario?.Email;
        AplicarModeloEmail();
    }

    private void AplicarModeloEmail()
    {
        _emailAssunto = "Acompanhamento: {titulo}";
        _emailCorpo = "Olá,\n\nGostaria de saber como está o andamento do cartão \"{titulo}\", atualmente em \"{lista}\" (prazo: {prazo}).\n\nPode me dar um retorno?\n\nAcesse o cartão: {link}\n\nObrigado!";
    }

    private void AdicionarDestinatario(string email)
    {
        var atuais = (_emailPara ?? "").Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (atuais.Contains(email, StringComparer.OrdinalIgnoreCase)) return;
        atuais.Add(email);
        _emailPara = string.Join("; ", atuais);
    }

    private void PreVisualizarEmail()
    {
        var invalidos = (_emailPara ?? "").Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(e => !System.Net.Mail.MailAddress.TryCreate(e, out _)).ToList();
        if (invalidos.Count > 0)
        {
            Snackbar.Add($"E-mail inválido: {string.Join(", ", invalidos)}", Severity.Warning);
            return;
        }
        _emailPreVisualizando = true;
    }

    // O texto digitado é sempre codificado; só os marcadores gerados pelo sistema (como o link) viram HTML.
    private string MontarCorpoEmailHtml()
        => SubstituirMarcadores(System.Net.WebUtility.HtmlEncode(_emailCorpo ?? "").Replace("\n", "<br>", StringComparison.Ordinal), html: true);

    private string SubstituirMarcadores(string texto, bool html)
    {
        if (_cartao is null) return texto;
        string Valor(string v) => html ? System.Net.WebUtility.HtmlEncode(v) : v;
        var link = html
            ? $"<a href=\"{System.Net.WebUtility.HtmlEncode(LinkCartao)}\">{System.Net.WebUtility.HtmlEncode(LinkCartao)}</a>"
            : LinkCartao;
        return texto
            .Replace("{titulo}", Valor(_cartao.Titulo), StringComparison.OrdinalIgnoreCase)
            .Replace("{prazo}", Valor(_cartao.Prazo?.ToLocalTime().ToString("dd/MM/yyyy") ?? "sem prazo"), StringComparison.OrdinalIgnoreCase)
            .Replace("{lista}", Valor(NomeLista(_cartao.ListaId) ?? _cartao.Lista.Nome), StringComparison.OrdinalIgnoreCase)
            .Replace("{solicitante}", Valor(_cartao.Solicitante?.Nome ?? ""), StringComparison.OrdinalIgnoreCase)
            .Replace("{link}", link, StringComparison.OrdinalIgnoreCase);
    }

    private string? NomeLista(int id)
    {
        var lista = _listas.FirstOrDefault(l => l.Id == id);
        return lista is null ? null : ListasQuadro.NomeCompleto(lista, _listas);
    }

