    private async Task AdicionarAnexo(InputFileChangeEventArgs args)
    {
        if (_cartao is null) return;
        var arquivo = args.File;

        var config = Configuracao.GetSection("Anexos");
        var extensoesPermitidas = (config["ExtensoesPermitidas"] ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var limiteMbArquivo = int.TryParse(config["TamanhoMaximoMbPorArquivo"], out var mbArquivo) ? mbArquivo : 20;
        var limiteMbTotal = int.TryParse(config["TamanhoMaximoMbTotal"], out var mbTotal) ? mbTotal : 100;
        var limite = limiteMbArquivo * 1024L * 1024L;

        var extensao = Path.GetExtension(arquivo.Name);
        if (extensoesPermitidas.Count > 0 && !extensoesPermitidas.Contains(extensao))
        {
            Snackbar.Add($"Extensão '{extensao}' não permitida. Extensões aceitas: {string.Join(", ", extensoesPermitidas)}.", Severity.Warning);
            return;
        }
        if (arquivo.Size > limite)
        {
            Snackbar.Add($"O arquivo excede o limite de {limiteMbArquivo} MB.", Severity.Warning);
            return;
        }
        var totalAtual = _cartao.Anexos.Sum(a => a.TamanhoBytes);
        if (totalAtual + arquivo.Size > limiteMbTotal * 1024L * 1024L)
        {
            Snackbar.Add($"O total de anexos do cartão excederia o limite de {limiteMbTotal} MB.", Severity.Warning);
            return;
        }

        // Anexos:EstrategiaNome — Guid (padrão), Original (nome enviado) ou CartaoOriginal (id do cartão + nome enviado).
        var nomeDesejado = (config["EstrategiaNome"] ?? "Guid").ToLowerInvariant() switch
        {
            "original" => arquivo.Name,
            "cartaooriginal" => $"{CartaoId}_{arquivo.Name}",
            _ => $"{Guid.NewGuid():N}{extensao}"
        };
        ArquivoArmazenado armazenado;
        try
        {
            await using var stream = arquivo.OpenReadStream(limite);
            armazenado = await AnexoStorage.SalvarAsync(stream, nomeDesejado, arquivo.ContentType);
        }
        catch (IOException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }
        var anexo = new Anexo
        {
            CartaoId = CartaoId, NomeOriginal = arquivo.Name, NomeArmazenado = Path.GetFileName(armazenado.Caminho),
            Caminho = armazenado.Caminho, ContentType = arquivo.ContentType, TamanhoBytes = arquivo.Size,
            Comprimido = armazenado.Comprimido, TamanhoArmazenadoBytes = armazenado.TamanhoArmazenado,
            EnviadoPorId = UsuarioProvider.ObterIdUsuarioAtual(), CriadoPorId = UsuarioProvider.ObterIdUsuarioAtual(), CriadoEm = DateTime.UtcNow
        };
        Db.Anexos.Add(anexo);
        await Db.SaveChangesAsync();
        IncluirUmaVez(_cartao.Anexos, anexo);
        Snackbar.Add("Anexo enviado.", Severity.Success);
    }

    private async Task AdicionarRelacao()
    {
        if (_cartao is null || _cartaoRelacionadoId == 0 || _cartaoRelacionadoId == CartaoId) return;
        if (await Db.RelacoesCartao.AnyAsync(r => r.CartaoOrigemId == CartaoId && r.CartaoDestinoId == _cartaoRelacionadoId && r.Tipo == _tipoRelacao)) return;
        var usuarioId = UsuarioProvider.ObterIdUsuarioAtual();
        var relacao = new RelacaoCartao
        {
            CartaoOrigemId = CartaoId, CartaoDestinoId = _cartaoRelacionadoId, Tipo = _tipoRelacao,
            CriadoPorId = usuarioId, CriadoEm = DateTime.UtcNow
        };
        Db.RelacoesCartao.Add(relacao);

        // "BloqueadoPor" gravado a partir deste cartão (origem) significa que ESTE cartão fica bloqueado
        // pelo destino; "Bloqueia" significa que quem fica bloqueado é o cartão destino.
        if (_tipoRelacao is TipoRelacaoCartao.BloqueadoPor or TipoRelacaoCartao.Bloqueia)
        {
            var cartaoBloqueadoId = _tipoRelacao == TipoRelacaoCartao.BloqueadoPor ? CartaoId : _cartaoRelacionadoId;
            var destinatarios = await Db.CartaoDesenvolvedores.Where(d => d.CartaoId == cartaoBloqueadoId).Select(d => d.UsuarioId).ToListAsync();
            var tituloBloqueado = _tipoRelacao == TipoRelacaoCartao.BloqueadoPor ? _cartao.Titulo : _outrosCartoes.First(c => c.Id == _cartaoRelacionadoId).Titulo;
            Db.Notificacoes.AddRange(destinatarios.Where(id => id != usuarioId).Select(destinatario => new Notificacao
            {
                DestinatarioId = destinatario, CartaoOrigemId = cartaoBloqueadoId, Tipo = TipoNotificacao.BloqueioCartao,
                Mensagem = $"O cartão '{tituloBloqueado}' está bloqueado por outro cartão ainda não concluído.",
                CriadoPorId = usuarioId, CriadoEm = DateTime.UtcNow
            }));
        }

        await Db.SaveChangesAsync();
        relacao.CartaoDestino = _outrosCartoes.First(c => c.Id == _cartaoRelacionadoId);
        _relacoes.Add(relacao);
    }

