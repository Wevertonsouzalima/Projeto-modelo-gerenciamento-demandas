@inject KanbanDbContext Db
@inject IUsuarioAtualProvider UsuarioProvider
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Etiquetas do quadro</MudText>

        @foreach (var etiqueta in _etiquetas)
        {
            <MudPaper Class="pa-3 mt-3" Outlined="true">
                <div class="d-flex align-center justify-space-between gap-2">
                    <div class="d-flex align-center gap-2">
                        <div style="@($"width:20px;height:20px;border-radius:4px;background:{etiqueta.Cor}")"></div>
                        <MudText Typo="Typo.subtitle2">@etiqueta.Nome</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Excluir(etiqueta))" />
                </div>
            </MudPaper>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1">Nova etiqueta</MudText>
        <div class="d-flex gap-3 mt-2 align-center">
            <MudTextField @bind-Value="_nome" Label="Nome" Required="true" />
            <MudTextField @bind-Value="_cor" Label="Cor (hex)" MaxLength="20" />
            <div style="@($"width:32px;height:32px;border-radius:4px;background:{_cor};flex-shrink:0")"></div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Fechar">Fechar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_nome)" OnClick="Adicionar">Adicionar etiqueta</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int QuadroId { get; set; }

    private List<Etiqueta> _etiquetas = [];
    private string _nome = string.Empty;
    private string _cor = "#607D8B";

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
        => _etiquetas = await Db.Etiquetas.Where(e => e.QuadroId == QuadroId).OrderBy(e => e.Nome).ToListAsync();

    private async Task Adicionar()
    {
        if (string.IsNullOrWhiteSpace(_nome)) return;
        var usuarioId = UsuarioProvider.ObterIdUsuarioAtual();
        Db.Etiquetas.Add(new Etiqueta
        {
            Nome = _nome.Trim(), Cor = string.IsNullOrWhiteSpace(_cor) ? "#607D8B" : _cor.Trim(), QuadroId = QuadroId,
            CriadoPorId = usuarioId, CriadoEm = DateTime.UtcNow
        });
        await Db.SaveChangesAsync();
        _nome = string.Empty; _cor = "#607D8B";
        await Carregar();
        Snackbar.Add("Etiqueta adicionada.", Severity.Success);
    }

    private async Task Excluir(Etiqueta etiqueta)
    {
        var entidade = await Db.Etiquetas.FirstOrDefaultAsync(e => e.Id == etiqueta.Id);
        if (entidade is null) return;
        entidade.Excluido = true;
        entidade.ExcluidoEm = DateTime.UtcNow;
        entidade.ExcluidoPorId = UsuarioProvider.ObterIdUsuarioAtual();
        await Db.SaveChangesAsync();
        await Carregar();
    }

    private void Fechar() => MudDialog.Close(DialogResult.Ok(true));
}
